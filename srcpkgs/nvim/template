_luv_version=1.52.1-0
_lua_compat53_version=0.13
_lpeg_version=1.1.0
build_style=cmake
_deps_cmake_args="-DCMAKE_BUILD_TYPE=Release -DUSE_BUNDLED=OFF -DUSE_BUNDLED_LUAJIT=ON -DUSE_BUNDLED_LUV=ON -DUSE_BUNDLED_LPEG=ON"
configure_args="-DCOMPILE_LUA=ON -DPREFER_LUA=OFF ${_deps_cmake_args}"
makedepends="libuv-devel libutf8proc-devel tree-sitter-devel unibilium-devel"
short_desc="Fork of Vim aiming to improve user experience, plugins and GUIs"
maintainer="shivix <none>"
license="Apache-2.0 AND Vim"
homepage="https://neovim.io"
changelog="https://github.com/neovim/neovim/releases"
distfiles="https://github.com/neovim/neovim/archive/refs/tags/nightly.tar.gz
 https://github.com/luajit/luajit/archive/${_luajit_version}.tar.gz>luajit_${_luajit_version}.tar.gz
