skip_extraction="
 luajit_${_luajit_version}.tar.gz
 luv_${_luv_version}.tar.gz
 lua_compat53_${_lua_compat53_version}.tar.gz
 lpeg_${_lpeg_version}.tar.gz"

post_extract() {
	for _distfile in ${skip_extraction}; do
		vsrcextract -C .deps/build/src/${_distfile%_*} ${_distfile}
	done
}

pre_configure() {
	cmake -S cmake.deps -B .deps ${_deps_cmake_args} -DUSE_EXISTING_SRC_DIR=ON
	cmake --build .deps
}

post_install() {
	vlicense LICENSE.txt
}
